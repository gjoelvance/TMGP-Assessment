# Copy to .env and fill in. Never commit .env.

# Input files
PDF_PATH=data/report.pdf
XLSX_PATH=data/workbook.xlsx

# LLM (if ANTHROPIC_API_KEY is unset, an offline extractive answerer is used)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Embeddings: fastembed (BAAI/bge-small-en-v1.5, local CPU) or hash (offline, tests)
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Windows/Python 3.14: model download can crash via the Xet transfer path
HF_HUB_DISABLE_XET=1

# Vector store: set to use pgvector; leave empty for in-memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/docqa
TOP_K=4
